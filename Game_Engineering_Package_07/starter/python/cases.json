      {
        "input": {
          "scores": {
            "attack": 0.64,
            "retreat": 0.6
          },
          "current": "retreat",
          "margin": 0.05
        },
        "output": {
          "action": "retreat",
          "reason": "retained"
        }
      },
      {
        "input": {
          "scores": {
            "attack": 0.7,
            "retreat": 0.5
          },
          "current": "retreat",
          "margin": 0.05
        },
        "output": {
          "action": "attack",
          "reason": "selected"
        }
      },
      {
        "input": {
          "scores": {
            "a": 1,
            "b": 1
          },
          "current": null,
          "margin": 0
        },
        "output": {
          "action": "a",
          "reason": "selected"
