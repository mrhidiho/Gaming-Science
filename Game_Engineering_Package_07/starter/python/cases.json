      {
        "input": {
          "circles": [
            [
              2,
              -0.1,
              0,
              0.2
            ],
            [
              1,
              0.15,
              0,
              0.1
            ]
          ],
          "cell_size": 1
        },
        "output": {
          "candidates": [
            [
              1,
              2
